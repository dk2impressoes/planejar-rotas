{
    "type":  "object",
    "required":  [
                     "versao",
                     "atualizado_em",
                     "fonte",
                     "validade",
                     "pontos"
                 ],
    "properties":  {
                       "versao":  {
                                      "type":  "string",
                                      "maxLength":  40
                                  },
                       "atualizado_em":  {
                                             "type":  "string"
                                         },
                       "referencia_em":  {
                                             "type":  [
                                                          "string",
                                                          "null"
                                                      ]
                                         },
                       "fonte":  {
                                     "type":  "string",
                                     "maxLength":  500
                                 },
                       "validade":  {
                                        "type":  "string",
                                        "pattern":  "^\\d{4}-\\d{2}-\\d{2}$"
                                    },
                       "cobertura_completa":  {
                                                  "type":  "boolean"
                                              },
                       "pontos":  {
                                      "type":  "array",
                                      "maxItems":  5000,
                                      "items":  {
                                                    "type":  "object",
                                                    "required":  [
                                                                     "id",
                                                                     "tipo",
                                                                     "rodovia",
                                                                     "coordenadas",
                                                                     "sentido",
                                                                     "vigencias",
                                                                     "fonte"
                                                                 ],
                                                    "properties":  {
                                                                       "id":  {
                                                                                  "type":  "string"
                                                                              },
                                                                       "tipo":  {
                                                                                    "type":  "string",
                                                                                    "enum":  [
                                                                                                 "praca",
                                                                                                 "free_flow"
                                                                                             ]
                                                                                },
                                                                       "rodovia":  {
                                                                                       "type":  "string"
                                                                                   },
                                                                       "km":  {
                                                                                  "type":  [
                                                                                               "number",
                                                                                               "null"
                                                                                           ]
                                                                              },
                                                                       "coordenadas":  {
                                                                                           "type":  "object",
                                                                                           "required":  [
                                                                                                            "lat",
                                                                                                            "lon"
                                                                                                        ],
                                                                                           "properties":  {
                                                                                                              "lat":  {
                                                                                                                          "type":  "number",
                                                                                                                          "minimum":  -34,
                                                                                                                          "maximum":  6
                                                                                                                      },
                                                                                                              "lon":  {
                                                                                                                          "type":  "number",
                                                                                                                          "minimum":  -75,
                                                                                                                          "maximum":  -28
                                                                                                                      }
                                                                                                          }
                                                                                       },
                                                                       "coordenadas_verificadas":  {
                                                                                                       "type":  "boolean"
                                                                                                   },
                                                                       "sentido":  {
                                                                                       "type":  [
                                                                                                    "number",
                                                                                                    "string"
                                                                                                ]
                                                                                   },
                                                                       "vigencias":  {
                                                                                         "type":  "array",
                                                                                         "items":  {
                                                                                                       "type":  "object",
                                                                                                       "required":  [
                                                                                                                        "inicio",
                                                                                                                        "estado",
                                                                                                                        "nivel_verificacao",
                                                                                                                        "categorias"
                                                                                                                    ],
                                                                                                       "properties":  {
                                                                                                                          "estado":  {
                                                                                                                                         "type":  "string",
                                                                                                                                         "enum":  [
                                                                                                                                                      "confirmada",
                                                                                                                                                      "prevista"
                                                                                                                                                  ]
                                                                                                                                     },
                                                                                                                          "nivel_verificacao":  {
                                                                                                                                                    "type":  "string",
                                                                                                                                                    "enum":  [
                                                                                                                                                                 "primaria",
                                                                                                                                                                 "secundaria",
                                                                                                                                                                 "nao_verificado"
                                                                                                                                                             ]
                                                                                                                                                },
                                                                                                                          "categorias":  {
                                                                                                                                             "type":  "object",
                                                                                                                                             "additionalProperties":  {
                                                                                                                                                                          "type":  "number",
                                                                                                                                                                          "minimum":  0
                                                                                                                                                                      }
                                                                                                                                         }
                                                                                                                      }
                                                                                                   }
                                                                                     }
                                                                   }
                                                }
                                  }
                   }
}