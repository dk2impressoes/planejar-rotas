{
    "type":  "object",
    "required":  [
                     "versao",
                     "atualizado_em",
                     "fonte",
                     "validade",
                     "type",
                     "features",
                     "nivel_verificacao"
                 ],
    "properties":  {
                       "versao":  {
                                      "type":  "string",
                                      "maxLength":  40
                                  },
                       "atualizado_em":  {
                                             "type":  "string"
                                         },
                       "referencia_em":  {
                                             "type":  [
                                                          "string",
                                                          "null"
                                                      ]
                                         },
                       "fonte":  {
                                     "type":  "string",
                                     "maxLength":  500
                                 },
                       "validade":  {
                                        "type":  "string",
                                        "pattern":  "^\\d{4}-\\d{2}-\\d{2}$"
                                    },
                       "type":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "FeatureCollection"
                                             ]
                                },
                       "nivel_verificacao":  {
                                                 "type":  "string",
                                                 "enum":  [
                                                              "primaria",
                                                              "secundaria",
                                                              "nao_verificado"
                                                          ]
                                             },
                       "features":  {
                                        "type":  "array",
                                        "maxItems":  50,
                                        "items":  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "geometry"
                                                                   ],
                                                      "properties":  {
                                                                         "geometry":  {
                                                                                          "type":  "object",
                                                                                          "required":  [
                                                                                                           "type",
                                                                                                           "coordinates"
                                                                                                       ],
                                                                                          "properties":  {
                                                                                                             "type":  {
                                                                                                                          "type":  "string",
                                                                                                                          "enum":  [
                                                                                                                                       "Polygon",
                                                                                                                                       "MultiPolygon"
                                                                                                                                   ]
                                                                                                                      },
                                                                                                             "coordinates":  {
                                                                                                                                 "type":  "array"
                                                                                                                             }
                                                                                                         }
                                                                                      }
                                                                     }
                                                  }
                                    }
                   }
}